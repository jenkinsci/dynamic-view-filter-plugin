<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <!-- Standard View content (tab bar, project table, etc.) -->
  <st:include page="main.jelly" class="hudson.model.View"/>

  <!-- Dropdown filter bar (positioned after tab bar via external JS) -->
  <j:if test="${!empty(it.dropdowns)}">
    <link rel="stylesheet" href="${resURL}/plugin/dynamic-view-filter/css/dropdown-view.css"/>
    <script src="${resURL}/plugin/dynamic-view-filter/js/dropdown-view.js"></script>
    <div id="dynamic-view-filter-bar" data-position="${it.filterPosition}"
         class="dvf-filter-bar jenkins-hidden">
      <div class="dvf-toggle-row">
        <button type="button" class="jenkins-button jenkins-button--tertiary jenkins-!-destructive-color"
                id="dvf-clear-all">
          <l:icon src="symbol-close-circle-outline plugin-ionicons-api" class="icon-sm"/><span class="dvf-reset-label"> Reset</span>
        </button>
        <button type="button" class="jenkins-button jenkins-button--tertiary"
                id="dvf-toggle">
          <l:icon src="symbol-options-outline plugin-ionicons-api" class="icon-sm"/>
        </button>
      </div>
      <div id="dvf-content">
        <form id="dvf-form" method="GET" action="">
          <j:choose>
            <j:when test="${it.filterPosition == 'sidebar'}">
              <!-- Sidebar: vertical stacked dropdowns -->
              <div class="dvf-sidebar-layout">
                <j:forEach var="dd" items="${it.dropdowns}" varStatus="loop">
                  <div>
                    <label class="jenkins-form-label">${dd.label}</label>
                    <div class="jenkins-select">
                      <select name="dd_${loop.index}" class="jenkins-select__input">
                        <option value="">-- All --</option>
                        <j:forEach var="val" items="${it.getDropdownValues(dd)}">
                          <j:set var="isSelected" value="${val == it.getSelectedValue(loop.index)}"/>
                          <j:choose>
                            <j:when test="${isSelected}">
                              <option value="${val}" selected="selected">${val}</option>
                            </j:when>
                            <j:otherwise>
                              <option value="${val}">${val}</option>
                            </j:otherwise>
                          </j:choose>
                        </j:forEach>
                      </select>
                    </div>
                  </div>
                </j:forEach>
              </div>
            </j:when>
            <j:otherwise>
              <!-- Top: horizontal flex row -->
              <div class="dvf-top-layout">
                <j:forEach var="dd" items="${it.dropdowns}" varStatus="loop">
                  <div class="dvf-dropdown-item">
                    <label class="jenkins-form-label">${dd.label}</label>
                    <div class="jenkins-select">
                      <select name="dd_${loop.index}" class="jenkins-select__input">
                        <option value="">-- All --</option>
                        <j:forEach var="val" items="${it.getDropdownValues(dd)}">
                          <j:set var="isSelected" value="${val == it.getSelectedValue(loop.index)}"/>
                          <j:choose>
                            <j:when test="${isSelected}">
                              <option value="${val}" selected="selected">${val}</option>
                            </j:when>
                            <j:otherwise>
                              <option value="${val}">${val}</option>
                            </j:otherwise>
                          </j:choose>
                        </j:forEach>
                      </select>
                    </div>
                  </div>
                </j:forEach>
              </div>
            </j:otherwise>
          </j:choose>
        </form>
      </div>
    </div>
  </j:if>
</j:jelly>
